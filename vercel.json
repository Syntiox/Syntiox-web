{
  "redirects": [
    {
      "source": "/contact",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/product",
      "destination": "/products",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/u/:username",
      "destination": "/api/profile?handle=:username"
    }
  ],
  "cleanUrls": true
}
